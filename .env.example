# API Key for server-to-server authentication
# Generate a secure random string (32+ characters recommended):
#   openssl rand -base64 32
# Then set this same value in your Cloudflare Worker environment
API_KEY=your-api-key-here

# Service Token for WAF bypass (Cloudflare Worker → Vercel)
# Used in X-Service-Token header to bypass rate limiting
# Generate with: openssl rand -base64 32
SERVICE_TOKEN=your-service-token-here
# Set this value in Vercel WAF custom rules as the bypass condition
