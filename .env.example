# Base64url-encoded Ed25519 public key in SPKI DER format.
# Generate a key pair offline, then encode the public key:
#   openssl genpkey -algorithm ED25519 -out ed25519-private.pem
#   openssl pkey -in ed25519-private.pem -pubout -outform DER | base64 -w0 | tr '+/' '-_' | tr -d '='
ED25519_PUBLIC_KEY=your-base64-public-key-here

# Upstash Redis REST connection used for one-time request nonces.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token-here
